class_name SaloonLevel
extends Node3D
## The blocked-out saloon arena. Scene layout is generated by tools/build_scenes.gd and can be edited freely
## in the editor as long as these node names stay: Nav, Barricades/*, PlayerSpawns/*, EnemySpawns/*, Barrels/*.

var barricades: Array[Barricade] = []
var barrels: Array[ExplosiveBarrel] = []
var player_spawns: Array[Marker3D] = []
var enemy_spawns: Array[Marker3D] = []

@onready var nav_region: NavigationRegion3D = $Nav


func _ready() -> void:
	add_to_group("level")
	for b in $Barricades.get_children():
		barricades.append(b as Barricade)
	barricades.sort_custom(func(a: Barricade, b: Barricade) -> bool: return a.index < b.index)
	for b in $Barrels.get_children():
		barrels.append(b as ExplosiveBarrel)
	for m in $PlayerSpawns.get_children():
		player_spawns.append(m as Marker3D)
	for m in $EnemySpawns.get_children():
		enemy_spawns.append(m as Marker3D)


func player_spawn(i: int) -> Transform3D:
	return player_spawns[i % player_spawns.size()].global_transform


func enemy_spawn_point(entrance: int) -> Vector3:
	return enemy_spawns[entrance % enemy_spawns.size()].global_position


## Host only: zombies need the navmesh, clients never path-find. Baking at runtime means edits to the
## level geometry are picked up automatically.
func bake_navigation() -> void:
	if nav_region.navigation_mesh == null:
		push_warning("SaloonLevel: no NavigationMesh resource on Nav")
		return
	nav_region.bake_navigation_mesh(false)


func reset_run() -> void:
	for b in barricades:
		b.srv_reset()
	for b in barrels:
		b.srv_reset()
	var annex := get_node_or_null("Annex") as Annex
	if annex != null:
		annex.srv_reset()
	for i in get_tree().get_nodes_in_group("interactables"):
		(i as Interactable).srv_reset()
